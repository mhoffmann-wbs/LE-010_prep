{
  "name": "le-010-prep",
  "private": true,
  "version": "0.0.0",
  "description": "LE-010_prep: self-study web app for the LPI Linux Essentials (010-200) exam.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "content:status": "node scripts/content-status.ts",
    "content:quality": "node scripts/content-quality.ts",
    "content:links": "node scripts/content-links.ts",
    "content:verify": "node scripts/content-verify.ts",
    "vm:build": "bash scripts/vm/build-image.sh",
    "vm:state": "node scripts/vm/build-state.ts",
    "vm:smoke": "node scripts/vm/smoke.ts",
    "vm:run": "node scripts/vm/run.ts",
    "transcripts:capture": "node scripts/capture-transcripts/capture.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "v86": "0.5.476",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
